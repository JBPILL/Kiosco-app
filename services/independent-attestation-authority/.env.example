# ==============================================================================
# Independent Attestation Authority — Environment Configuration Example
# NO SECRETS OR PRIVATE KEYS MUST EVER BE STORED HERE OR IN ANY .env FILE IN GIT
# ==============================================================================

# Explicit deployment environment: TEST | DEVELOPMENT | STAGING | PRODUCTION
# Note: NODE_ENV=production alone is NOT accepted as an authorization control.
ATTESTATION_ENVIRONMENT=TEST

# Signing provider selection:
# - TEST_SIGNER (strictly forbidden in STAGING and PRODUCTION)
# - PRODUCTION_KMS_SIGNER (mandatory for STAGING and PRODUCTION; requires KMS client binding)
ATTESTATION_SIGNING_PROVIDER=TEST_SIGNER

# Public identity of the Attestation Authority (must differ from GO Authority)
ATTESTATION_AUTHORITY_ID=kioskopos-independent-attestation-authority-dev

# KMS Key Version resource identifier (non-secret reference, e.g. projects/.../cryptoKeys/.../cryptoKeyVersions/1)
# Leave empty unless provisioning against real Cloud KMS
ATTESTATION_KMS_KEY_VERSION=

# Expected public key fingerprint (ed25519-spki-<16-hex>) and PEM SPKI public key (public material only)
ATTESTATION_PUBLIC_KEY_ID=
ATTESTATION_PUBLIC_KEY_SPKI=

# Separation guard: public GO Authority keyId that must NEVER collide with Attestation Authority
ATTESTATION_GO_KEY_ID=

# Network listener settings
ATTESTATION_SERVICE_HOST=127.0.0.1
ATTESTATION_SERVICE_PORT=8080

# TLS termination posture:
# Set ATTESTATION_TRUST_PROXY_HTTPS=true behind Cloud Run / ALB TLS 1.3 ingress
# Set ATTESTATION_REQUIRE_HTTPS=true for direct TLS termination inside Node
ATTESTATION_TRUST_PROXY_HTTPS=false
ATTESTATION_REQUIRE_HTTPS=false

# Anti-replay persistence mode:
# - memory (HOST_LOCAL_SERVICE_IN_MEMORY_ONE_TIME_USE — rejected in STAGING/PRODUCTION)
# - file (HOST_LOCAL_SERVICE_DURABLE_ONE_TIME_USE — single node only)
# - distributed (DISTRIBUTED_MULTI_NODE_ONE_TIME_USE — requires wired external DB backend)
ATTESTATION_ANTI_REPLAY_MODE=memory
ATTESTATION_ANTI_REPLAY_FILE=/var/run/attestation/anti-replay.json
