# ==============================================================================
# Independent Attestation Authority — Environment Configuration Example
# NO SECRETS OR PRIVATE KEYS MUST EVER BE STORED HERE OR IN ANY .env FILE IN GIT
# ==============================================================================

# Explicit deployment environment: TEST | DEVELOPMENT | STAGING | PRODUCTION
# Note: NODE_ENV=production alone is NOT accepted as an authorization control.
ATTESTATION_ENVIRONMENT=TEST

# Signing provider selection:
# - TEST_SIGNER (strictly forbidden in STAGING and PRODUCTION)
# - PRODUCTION_KMS_SIGNER (mandatory for STAGING and PRODUCTION; requires KMS client binding)
ATTESTATION_SIGNING_PROVIDER=TEST_SIGNER

# Public identity of the Attestation Authority (must differ from GO Authority)
ATTESTATION_AUTHORITY_ID=kioskopos-independent-attestation-authority-dev

# KMS Provider & Key Version resource identifier (non-secret references only)
# Leave empty unless provisioning against real Cloud KMS / AWS KMS
ATTESTATION_KMS_PROVIDER=
ATTESTATION_KMS_KEY_ID=
ATTESTATION_KMS_KEY_VERSION=
ATTESTATION_KMS_KEY_VERSION_NAME=
ATTESTATION_KMS_ENDPOINT=
ATTESTATION_KMS_TIMEOUT_MS=5000

# Expected public key fingerprint (ed25519-spki-<16-hex>) and PEM SPKI public key (public material only)
ATTESTATION_KEY_ID=
ATTESTATION_PUBLIC_KEY_ID=
ATTESTATION_PUBLIC_KEY_SPKI=

# Separation guard: public GO Authority keyId, authorityId and SPKI public key (never collide with Attestation Authority)
ATTESTATION_GO_AUTHORITY_ID=
ATTESTATION_GO_KEY_ID=
ATTESTATION_GO_PUBLIC_KEY_SPKI=

# Protected mode & policy pinning (mandatory in STAGING/PRODUCTION)
ATTESTATION_PROTECTED_MODE=
ATTESTATION_REQUIRE_SIGNED_GO_GRANT=
ATTESTATION_ALLOWED_PROJECT_REF=
ATTESTATION_ALLOWED_COMMIT_SHA=
ATTESTATION_RESPONSE_VERSION=1.0
ATTESTATION_CLIENT_AUTH_MODE=INJECTED_VERIFIER

# Real infrastructure integration guard & phased controlled validation (MUST remain false locally/CI unless explicit opt-in)
ATTESTATION_REAL_INTEGRATION_ENABLED=false
ATTESTATION_REAL_INTEGRATION_DRY_RUN=false
ATTESTATION_CONNECTIVITY_TEST_ENABLED=false
ATTESTATION_ALLOW_CONTROLLED_CONNECTIVITY_TEST=false
ATTESTATION_EXTERNAL_CONNECTIVITY_APPROVAL=
ATTESTATION_EXPLICIT_CONNECTIVITY_APPROVAL=false
ATTESTATION_INTEGRATION_PHASE=PHASE_0_CONFIG_VALIDATION
ATTESTATION_ALLOW_CONTROLLED_MUTATION_TEST=false
ATTESTATION_ALLOW_CONTROLLED_CONCURRENCY_TEST=false
ATTESTATION_ALLOW_CONTROLLED_KMS_TEST=false
ATTESTATION_ALLOW_CONTROLLED_AUTH_TEST=false
ATTESTATION_DEPLOYMENT_CANDIDATE_OPT_IN=false
ATTESTATION_ANTI_REPLAY_PROVIDER=

# Controlled PostgreSQL anti-replay settings (ONLY active when ATTESTATION_REAL_INTEGRATION_ENABLED=true)
# Dedicated instance strictly separated from POS/Supabase operational & fiscal DBs; remote requires sslmode=verify-full
ATTESTATION_POSTGRES_URL=
ATTESTATION_POSTGRES_TABLE=attestation_distributed_anti_replay
ATTESTATION_POSTGRES_QUERY_TIMEOUT_MS=5000
ATTESTATION_POSTGRES_STATEMENT_TIMEOUT_MS=4000
ATTESTATION_POSTGRES_ISOLATION_LEVEL=READ COMMITTED
ATTESTATION_POSTGRES_POOL_MAX=10
ATTESTATION_POSTGRES_SSL_CA_PEM=

# Controlled AWS DynamoDB anti-replay settings (ONLY active when ATTESTATION_REAL_INTEGRATION_ENABLED=true)
ATTESTATION_DYNAMODB_TABLE=
ATTESTATION_AWS_REGION=
ATTESTATION_DYNAMODB_RETENTION_TTL_SECONDS=

# Controlled OIDC / JWT S2S client authentication settings
ATTESTATION_OIDC_ISSUER=
ATTESTATION_OIDC_AUDIENCE=
ATTESTATION_OIDC_JWKS_URI=
ATTESTATION_OIDC_ALLOWED_JWKS_HOSTS=
ATTESTATION_OIDC_ALLOWED_ALGORITHMS=EdDSA,RS256,ES256
ATTESTATION_OIDC_ALLOWED_CLIENT_IDS=

# Controlled mTLS S2S client authentication settings (certificates/public metadata only; never private keys)
ATTESTATION_MTLS_TRUSTED_CA_PEM=
ATTESTATION_MTLS_TRUSTED_CLIENTS_JSON=

# Network listener & HTTP guardrails
ATTESTATION_SERVICE_HOST=127.0.0.1
ATTESTATION_SERVICE_PORT=8080
ATTESTATION_ALLOWED_HOSTS=
ATTESTATION_MAX_BODY_BYTES=1048576

# TLS termination posture:
# Set ATTESTATION_TRUST_PROXY_HTTPS=true behind Cloud Run / ALB TLS 1.3 ingress
# Set ATTESTATION_REQUIRE_HTTPS=true or ATTESTATION_TLS_REQUIRED=true for direct TLS termination inside Node
ATTESTATION_TRUST_PROXY_HTTPS=false
ATTESTATION_REQUIRE_HTTPS=false
ATTESTATION_TLS_REQUIRED=false

# Anti-replay persistence mode (memory|file|distributed, or IN_MEMORY|LOCAL_DURABLE|DISTRIBUTED_MULTI_NODE):
# - memory / IN_MEMORY (HOST_LOCAL_SERVICE_IN_MEMORY_ONE_TIME_USE — rejected in STAGING/PRODUCTION)
# - file / LOCAL_DURABLE (HOST_LOCAL_SERVICE_DURABLE_ONE_TIME_USE — single node only)
# - distributed / DISTRIBUTED_MULTI_NODE (DISTRIBUTED_MULTI_NODE_ONE_TIME_USE — requires wired external DB backend)
ATTESTATION_ANTI_REPLAY_MODE=memory
ATTESTATION_ANTI_REPLAY_BACKEND=IN_MEMORY
ATTESTATION_ANTI_REPLAY_FILE=/var/run/attestation/anti-replay.json
ATTESTATION_NODE_ID=
ATTESTATION_RESERVATION_LEASE_TTL_MS=30000
