# Obtener estos valores del dashboard de Supabase:
# Settings > API > Project URL y anon/public key
VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_ANON_KEY=tu-anon-key-aqui
# Administración comercial independiente; instalar módulo SQL/Edge antes de habilitar.
# No habilita AFIP, Point, devoluciones ni envases en piloto estricto.
VITE_ADMIN_COMERCIAL_HABILITADO=false
